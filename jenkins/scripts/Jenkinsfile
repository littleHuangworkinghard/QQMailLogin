pipeline {
    agent any

    environment {
        PROJECT_NAME = 'QQMailLogin'
        REPORTS_DIR = 'target'
    }

    // 工具配置
    tools {
        maven 'Maven3'  // Jenkins 中配置的 Maven
        jdk 'JDK21'     // Jenkins 中配置的 JDK
    }

    options {
        timeout(time: 30, unit: 'MINUTES')  // 超时设置
        buildDiscarder(logRotator(numToKeepStr: '5'))  // 保留最近5个构建
    }

    stages {
         // 新增一个阶段：清理工作空间
         stage('Clean Workspace') {
                    steps {
                        cleanWs() // 这就是清理工作空间的指令
                    }
                }
        // 阶段1：代码检出
        stage('Checkout') {
            steps {
                echo '🔽 检出代码...'
                checkout scm
            }
        }

        // 阶段2：环境检查（简化版，针对Windows优化）
        stage('Environment Setup') {
            steps {
                echo '🔧 设置测试环境...'

                script {
                    // 检查Java和Maven版本
                    if (isUnix()) {
                        sh 'java -version'
                        sh 'mvn -v'
                    } else {
                        bat 'java -version'
                        bat 'mvn -v'
                    }
                }
            }
        }

        // 阶段3：编译项目
        stage('Build') {
            steps {
                echo '🏗️ 编译项目...'
                script {
                    if (isUnix()) {
                        sh 'mvn clean compile -DskipTests'
                    } else {
                        bat 'mvn clean compile -DskipTests'
                    }
                }
            }
        }

        // 阶段4：运行测试
        stage('Test') {
            steps {
                echo '🧪 运行所有测试...'

                script {
                    if (isUnix()) {
                        sh 'mvn test -Dallure.results.directory=target/allure-results'
                    } else {
                        bat 'mvn test -Dallure.results.directory=target/allure-results'
                    }
                }
            }

            post {
                always {
                    // 1. 保存JUnit结果
                    junit 'target/surefire-reports/**/*.xml'

                    // 2. 生成Allure报告
                    script {
                        allure([
                            includeProperties: false,
                            jdk: '',
                            results: [[path: 'target/allure-results']],
                            report: 'target/allure-report',
                            reportBuildPolicy: 'ALWAYS'
                        ])
                    }

                    // 3. 归档其他报告
                    archiveArtifacts artifacts: 'target/ExtentReport-*.html', allowEmptyArchive: true
                    archiveArtifacts artifacts: 'target/screenshots/*.png', allowEmptyArchive: true
                }
            }
        }

        // 阶段5：生成详细报告
        stage('Generate Detailed Reports') {
            steps {
                echo '📊 生成详细报告...'

                script {
                    if (isUnix()) {
                        sh 'mvn allure:aggregate 2>/dev/null || echo "Allure聚合报告生成失败，继续..."'
                    } else {
                        bat 'mvn allure:aggregate 2>nul || echo "Allure聚合报告生成失败，继续..."'
                    }
                }
            }
        }
    }

    post {
        always {
            echo "🎯 构建完成 - ${currentBuild.currentResult}"

            // 发布HTML报告到Jenkins
            script {
                // 发布Allure报告
                if (fileExists('target/allure-report/index.html')) {
                    publishHTML([
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'target/allure-report',
                        reportFiles: 'index.html',
                        reportName: 'Allure Test Report',
                        reportTitles: 'Allure 测试报告'
                    ])
                }

                // 发布ExtentReports（如果存在）- 修改后的版本
                def extentReportFile = null
                if (isUnix()) {
                    def result = sh(script: 'find target -name "ExtentReport-*.html" -type f | head -1', returnStdout: true).trim()
                    if (result) {
                        extentReportFile = result
                    }
                } else {
                    def result = bat(script: '@echo off && for /r target %%i in (ExtentReport-*.html) do echo %%i && exit /b 0', returnStdout: true).trim()
                    if (result && !result.contains("echo off")) {
                        extentReportFile = result
                    }
                }

                if (extentReportFile) {
                    def fileName = new File(extentReportFile).getName()
                    publishHTML([
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'target',
                        reportFiles: fileName,
                        reportName: 'Extent Test Report',
                        reportTitles: 'ExtentReports 测试报告'
                    ])
                }

                // 清理截图文件（可选）
                script {
                    if (isUnix()) {
                        sh 'rm -rf target/screenshots/* 2>/dev/null || true'
                    } else {
                        bat 'if exist "target\\screenshots\\*" del /q "target\\screenshots\\*" 2>nul'
                    }
                }
            }
        }

        success {
            echo '✅ 构建成功！'
            // 如果需要邮件通知，可以在这里添加
            // emailext(
            //     subject: "构建成功: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
            //     body: "项目构建成功，请查看报告。",
            //     to: 'your-email@example.com'
            // )
        }

        failure {
            echo '❌ 构建失败！'
            // 失败时邮件通知
            // emailext(
            //     subject: "构建失败: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
            //     body: "项目构建失败，请检查日志。",
            //     to: 'your-email@example.com'
            // )
        }

        unstable {
            echo '⚠️ 构建不稳定（测试失败）！'
        }
    }
}